{
  "name": "mira",
  "private": true,
  "version": "0.0.0",
  "description": "Mira — your closet, your stylist, your mirror.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mobile": "npm run start --workspace @mira/mobile",
    "api": "npm run dev --workspace @mira/api",
    "worker": "npm run dev --workspace @mira/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "eval": "npm run eval --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace @mira/api",
    "db:seed": "npm run db:seed --workspace @mira/api",
    "verify": "npm run typecheck && npm run lint && npm run test"
  }
}
