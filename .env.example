# ---------------------------------------------------------------------------
# Mira — example environment
#
# Copy to .env.local and fill in. NEVER commit a real .env file.
# NEVER expose any value in this file to the mobile client unless it is
# explicitly prefixed EXPO_PUBLIC_. See docs/07-security/security-rules.md.
# ---------------------------------------------------------------------------

# --- Environment -----------------------------------------------------------
NODE_ENV=development
MIRA_ENV=local                      # local | dev | staging | production
LOG_LEVEL=debug

# --- API -------------------------------------------------------------------
API_PORT=4000
API_BASE_URL=http://localhost:4000
API_CORS_ORIGINS=http://localhost:8081

# --- Mobile (safe to ship to the client) -----------------------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_ENV=local

# --- Database --------------------------------------------------------------
# Port 5433, not 5432: docker-compose maps Mira off the default so it never
# collides with a Postgres you already run. See docker-compose.yml.
DATABASE_URL=postgresql://mira:mira@localhost:5433/mira
DATABASE_POOL_MAX=10

# --- Auth ------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — never send to the client
JWT_AUDIENCE=mira

# --- Object storage (private buckets only) ---------------------------------
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET_GARMENTS=mira-garments
STORAGE_BUCKET_BODY=mira-body       # body references — strictest access rules
STORAGE_BUCKET_TRYON=mira-tryon
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_SIGNED_URL_TTL_SECONDS=300

# --- AI providers (server only) --------------------------------------------
# Mira uses a provider-independent abstraction. See docs/06-ai/model-strategy.md
ANTHROPIC_API_KEY=
AI_VISION_PROVIDER=anthropic
AI_VISION_MODEL=claude-opus-5
AI_REASONING_PROVIDER=anthropic
AI_REASONING_MODEL=claude-sonnet-5
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_MODEL=
AI_SEGMENTATION_PROVIDER=
AI_OCR_PROVIDER=
AI_TRYON_PROVIDER=
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# --- Background jobs -------------------------------------------------------
REDIS_URL=redis://localhost:6380
WORKER_CONCURRENCY=4

# --- Email purchase detection ----------------------------------------------
# Request the narrowest scope technically possible. See docs/07-security/permissions.md
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:4000/integrations/email/callback
EMAIL_TOKEN_ENCRYPTION_KEY=         # 32-byte key, base64 — encrypts stored OAuth tokens

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Feature flags ---------------------------------------------------------
FEATURE_EMAIL_IMPORT=false
FEATURE_TRY_ON=false
FEATURE_AUTO_IMPORT_HIGH_CONFIDENCE=false
