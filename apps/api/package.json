{
  "name": "@mira/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsc -b && node --watch dist/index.js",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:migrate": "node dist/db/migrate.js",
    "db:seed": "node dist/db/seed.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "predb:migrate": "tsc -b",
    "predb:seed": "tsc -b"
  },
  "dependencies": {
    "@mira/ai": "*",
    "@mira/duplicates": "*",
    "@mira/imaging": "*",
    "@mira/storage": "*",
    "@mira/taxonomy": "*",
    "@mira/types": "*",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
