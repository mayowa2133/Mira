# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
.expo/
.expo-shared/
*.tsbuildinfo

# Environment — never commit real secrets
.env
.env.*
!.env.example

# Native — GENERATED by `npx expo prebuild` from app.json (Expo CNG).
# Committing them lets the native config drift from its source of truth, and
# every regeneration becomes an unreviewable diff.
apps/mobile/ios/
apps/mobile/android/
*.xcuserstate
DerivedData/

# Test / coverage
coverage/
.nyc_output/
test-results/
playwright-report/

# AI evaluation artefacts (may contain user-derived imagery)
docs/06-ai/eval-runs/
**/eval-output/

# Logs
*.log
npm-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
